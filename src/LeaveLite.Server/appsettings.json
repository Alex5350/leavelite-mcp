{
  // Authentication: the MCP endpoint at /mcp is intentionally anonymous in this demo.
  // Before exposing this host beyond localhost, front it with a reverse proxy that
  // authenticates callers (OAuth 2.1 bearer tokens are the MCP standard) — do NOT
  // ship this configuration to production as-is.
  "ConnectionStrings": {
    "LeaveLite": "Data Source=leavelite.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
